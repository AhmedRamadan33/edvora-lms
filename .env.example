# Paymob dashboard (live):
# - Redirection URL = https://edvora.codeversetechno.com/checkout/paymob/return
# - Transaction processed callback = https://edvora.codeversetechno.com/webhooks/paymob
# Stripe dashboard (live):
# - Webhook endpoint = https://edvora.codeversetechno.com/webhooks/stripe
# - Events: checkout.session.completed, checkout.session.expired, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, payment_intent.payment_failed
# PayTabs dashboard (live):
# - Return URL = https://edvora.codeversetechno.com/checkout/paytabs/return
# - Callback/IPN URL = https://edvora.codeversetechno.com/webhooks/paytabs
# PayPal dashboard (live):
# - Webhook endpoint = https://edvora.codeversetechno.com/webhooks/paypal
# - Events: CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED
# VdoCipher dashboard (live):
# - Webhook endpoint = https://edvora.codeversetechno.com/webhooks/vdocipher?token=VDOCIPHER_WEBHOOK_TOKEN
# Zoom Marketplace (OAuth app, one per platform, each instructor authorizes it individually):
# - Redirect URL for OAuth = https://edvora.codeversetechno.com/instructor/integrations/zoom/callback
# Google Cloud Console (OAuth client, Calendar API enabled, one per platform):
# - Authorized redirect URI = https://edvora.codeversetechno.com/instructor/integrations/google/callback
# - While the OAuth consent screen is in "Testing" status, each instructor's Google email must be
#   added as a test user in the GCP OAuth consent screen configuration before they can connect.

